{"version":1,"servers":{"":{"configHash":"439e4bd52f5f3e4bdfae5540796c38e759644c0cdf51c65ac7bf008c68fb3fe4","tools":[{"name":"browser_back","description":"Go back one page.","inputSchema":{"type":"object","properties":{"session":{"title":"Session","type":"string"}},"required":["session"],"title":"browser_backArguments"},"outputSchema":{"type":"object","properties":{"result":{"title":"Result","type":"string"}},"required":["result"],"title":"browser_backOutput"}},{"name":"browser_close","description":"Close the session's tab.","inputSchema":{"type":"object","properties":{"session":{"title":"Session","type":"string"}},"required":["session"],"title":"browser_closeArguments"},"outputSchema":{"type":"object","properties":{"result":{"title":"Result","type":"string"}},"required":["result"],"title":"browser_closeOutput"}},{"name":"browser_goto","description":"Navigate the session's tab to a URL.","inputSchema":{"type":"object","properties":{"session":{"title":"Session","type":"string"},"url":{"title":"Url","type":"string"}},"required":["session","url"],"title":"browser_gotoArguments"},"outputSchema":{"type":"object","properties":{"result":{"title":"Result","type":"string"}},"required":["result"],"title":"browser_gotoOutput"}},{"name":"browser_open","description":"Open a URL in a fresh tab and start a session. Returns the session id, the element table and the\n        FULL text of the page. Every other tool needs the session id this returns.","inputSchema":{"type":"object","properties":{"url":{"title":"Url","type":"string"}},"required":["url"],"title":"browser_openArguments"},"outputSchema":{"type":"object","properties":{"result":{"title":"Result","type":"string"}},"required":["result"],"title":"browser_openOutput"}},{"name":"browser_run","description":"THE MAIN NAVIGATION TOOL. State one goal in plain English and Jev (a fast browser model) clicks,\n        types, scrolls and waits toward it, then returns the page and a status: done, needs_input (type a value\n        into th